{
  "name": "homeserver-fan-control",
  "version": "0.3.0-alpha.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun nuxt dev --host 127.0.0.1",
    "build": "bun --bun nuxt build",
    "start": "bun scripts/entry.ts",
    "typecheck": "bun --bun nuxt typecheck",
    "test": "bun test tests",
    "lint": "bunx eslint .",
    "compile": "bun build scripts/entry.ts --compile --target=bun-linux-x64 --outfile dist/homeserver-fan-control"
  },
  "dependencies": {
    "nuxt": "^3.20.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
