    "zod": "^3.25.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/ssh2": "^1.15.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.1.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "@types/yauzl": "^2.10.3"
  },
  "license": "MIT"
